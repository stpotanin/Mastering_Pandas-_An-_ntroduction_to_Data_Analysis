      }
    },
    {
      "cell_type": "code",
      "source": [
        "import pandas as pd\n",
        "\n",
        "df = pd.Series([1, 2, 3, None, 5, None],dtype='float64')\n",
        "\n",
        "print(df)\n"
      ],
